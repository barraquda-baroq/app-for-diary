rules_version = '2';

// テスト（Firebase エミュレーター）用のアクセスルール。本番の firestore.rules から持ち主の制限だけを外したもの（NS と同じ考え方）。
// 同期のテストは、テストごとに別のアカウントを使って互いのデータが混ざらないようにしているため。
// 持ち主の制限そのものは、同期のテスト（src/sync/sync.emu.test.ts・src/sync/upgrade.emu.test.ts）で本番のルールを読み込んで確かめる
// （持ち主の記録 config/owner は、テストの最初に管理者の権限（エミュレーターの Authorization: Bearer owner）で作る。アプリからは作れない。形1）。
// エミュレーターにつないだ開発サーバーは持ち主を確かめないので、エミュレーターに config/owner を作らなくてよい（docs/DEPLOY.md の 7）。
// 本番のルールを変えた時は、こちらも同じように直す（段階6で Claude 用のコネクタの部分を足す）。
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function knownTable(t) {
      return t in ['items', 'offDays', 'labelNames', 'routines', 'routineChecks', 'favorites', 'mimNotes', 'inbox', 'trashEntries', 'trashRecords', 'itemPack'];
    }

    function validRecord(docId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['table', 'id', 'json', 'chunks', 'deleted', 'hash', 'updated', 'device', 'parent', 'parentTable', 'index', 'reset'])
        && d.table is string
        && (d.json == null || (d.json is string && d.json.size() <= 260000))
        && d.deleted is bool
        && d.hash is string
        && d.device is string
        && (!('reset' in d) || d.reset is bool)
        && d.updated == request.time
        && (d.table == '_chunk' ? validChunk(docId, d) : validDoc(docId, d));
    }

    function validDoc(docId, d) {
      return knownTable(d.table)
        && d.id is string
        && d.chunks is int && d.chunks >= 0
        && docId == d.table + ':' + d.id
        && !d.keys().hasAny(['parent', 'parentTable', 'index']);
    }

    function validChunk(docId, d) {
      return d.parent is string
        && d.parentTable is string
        && knownTable(d.parentTable)
        && d.index is int
        && docId == d.parent + '#' + string(d.index)
        && d.parent.split(':')[0] == d.parentTable;
    }

    match /config/owner {
      allow get: if signedIn();
      allow create, update, delete: if false;
    }

    match /config/connector {
      allow get: if signedIn();
      allow create, update, delete: if false;
    }

    match /users/{uid}/records/{docId} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid) && validRecord(docId);
      allow delete: if isSelf(uid);
    }

    function validAppModel() {
      let d = request.resource.data;
      return d.keys().hasOnly(['model', 'appVersion', 'updatedAt'])
        && d.keys().hasAll(['model', 'appVersion', 'updatedAt'])
        && d.model is int && d.model >= 1
        && d.appVersion is string && d.appVersion.size() <= 32
        && d.updatedAt == request.time;
    }

    match /users/{uid}/meta/app {
      allow get: if isSelf(uid);
      allow create: if isSelf(uid) && validAppModel();
      allow update: if isSelf(uid) && validAppModel()
        && request.resource.data.model >= resource.data.model;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
