rules_version = '2';

// Diary Studio のアクセスルール（docs/SPEC.md の 2.4・2.5・2.6）。NS の firestore.rules から、小説の表と
// Claude 用のコネクタの部分を外した、段階0（土台）の最小の形。
// - 持ち主: 最初にログインして同期を始めたアカウント（config/owner に記録。後から変えられない）。
//   持ち主を変えたい時は、Firebase コンソールの Firestore で config/owner を消してから、新しい持ち主でログインする（docs/DEPLOY.md の 3）。
// - 持ち主のデータは users/{uid}/records（1つの記録 = 1つの文書）と、データの形の版 users/{uid}/meta/app だけ。
//   持ち主本人だけが読み書きでき、ほかの場所は誰も読み書きできない。
// - 段階1（データと同期）で、記録の形（受け取り箱 inbox などの表・分けた文書の parentTable。6.14・2.4）に合わせて確かめを足す。
// - 段階6で、Claude 用のコネクタの部分（読ませる表を並べる・受け取り箱に依頼を作るだけ。MIM とゴミ箱は読めない。19.6）を足す。
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownerUid() {
      return get(/databases/$(database)/documents/config/owner).data.uid;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid && ownerUid() == uid;
    }

    // 1つの記録 = 1つの文書（NS の src/sync/codec.ts の RecordDoc / ChunkDoc に、分けた文書の親の表の名前 parentTable を足した形。2.4）
    function validRecord() {
      let d = request.resource.data;
      return d.keys().hasOnly(['table', 'id', 'json', 'chunks', 'deleted', 'hash', 'updated', 'device', 'parent', 'parentTable', 'index', 'reset'])
        && d.table is string && d.table.size() <= 64
        && (d.json == null || (d.json is string && d.json.size() <= 260000))
        && d.updated == request.time;
    }

    match /config/owner {
      allow get: if signedIn();
      // 段階0のアプリは持ち主を記録しない（docs/DEPLOY.md の 3）。公開したアプリの設定値（apiKey・projectId）は誰でも読めるので、
      // 段階0を公開してから段階1を入れるまでの間に、ほかの人が先に自分を持ち主として書けないよう、段階0では作るのも閉じておく。
      // 段階1（同期）で、エミュレーターのテストと一緒に次の形で開ける（NS と同じ形に、作った時刻がサーバーの時刻であることを足した物）:
      //   allow create: if signedIn()
      //     && request.auth.token.firebase.sign_in_provider != 'anonymous'  // 匿名のアカウント（段階6のコネクタ）は持ち主になれない
      //     && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
      //     && request.resource.data.uid == request.auth.uid
      //     && request.resource.data.createdAt == request.time;
      allow create: if false;
    }

    match /users/{uid}/records/{docId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validRecord();
      allow delete: if isOwner(uid);
    }

    // データの形の版（NS の src/sync/appModel.ts）: データを書いたアプリの形の版。古い版のアプリは、これが自分より高いと送らない。
    // 持ち主だけが書け、下げることはできない（戻したい時は、コンソールでこの文書を消す）
    function validAppModel() {
      let d = request.resource.data;
      return d.keys().hasOnly(['model', 'appVersion', 'updatedAt'])
        && d.keys().hasAll(['model', 'appVersion', 'updatedAt'])
        && d.model is int && d.model >= 1
        && d.appVersion is string && d.appVersion.size() <= 32
        && d.updatedAt == request.time;
    }

    match /users/{uid}/meta/app {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid) && validAppModel();
      allow update: if isOwner(uid) && validAppModel()
        && request.resource.data.model >= resource.data.model;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
